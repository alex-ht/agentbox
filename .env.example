# agentbox reads TAVILY_API_KEY from the process environment (it does not
# parse .env files itself). Copy this to `.env` for tools like direnv or
# dotenv, or export the variable in your shell profile.
#
# NEVER commit a real key. `.env` is git-ignored; keep it that way.
TAVILY_API_KEY=

# Optional contact in the Wikipedia User-Agent (an email or a URL).
# When unset, the agent string cites only https://github.com/alex-ht/agentbox.
# Do not commit a personal address.
# AGENTBOX_WIKI_CONTACT=
